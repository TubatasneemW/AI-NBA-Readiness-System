# =============================================================================
# AI-NBA Readiness System — Backend
# .env.example  —  copy to .env and fill in real values
#
# NEVER commit the real .env file.  It is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI-NBA Readiness System API"
APP_VERSION="0.1.0"
# Accepted values: development | staging | production
APP_ENV=development
DEBUG=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# Database URL format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
#
# For Docker Compose the host is typically the service name, e.g. "db".
# For local development outside Docker use "localhost".
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/nba_readiness

# SQLAlchemy connection-pool tuning (optional — defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Initial Admin & HOD Seed Credentials (used by `python -m app.db.seed`)
# ---------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-to-a-secure-admin-password!
INITIAL_HOD_EMAIL=hod@example.com
INITIAL_HOD_PASSWORD=change-to-a-secure-hod-password!
INITIAL_HOD_FACULTY_ID=HOD001
INITIAL_HOD_NAME=Head of Department
INITIAL_HOD_DEPARTMENT=Computer Science & Engineering

# ---------------------------------------------------------------------------
# Phase 4 — Document Storage
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_ROOT=./documents/uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# ---------------------------------------------------------------------------
# Phase 4 — AI Service Integration
# ---------------------------------------------------------------------------
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=30.0
AI_SERVICE_API_KEY=

# ---------------------------------------------------------------------------
# Phase 4 — RAG & Embeddings
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=local-minilm
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Phase 4 — OCR
# ---------------------------------------------------------------------------
# Leave blank to use system PATH, or set explicit path to tesseract executable
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# Phase 5 — Backup Storage
# ---------------------------------------------------------------------------
# Directory where backup archives are stored (must be outside DOCUMENT_STORAGE_ROOT
# and excluded from public web access). ADMIN role required for all backup endpoints.
BACKUP_STORAGE_ROOT=./backups
